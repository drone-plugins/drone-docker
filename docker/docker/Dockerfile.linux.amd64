FROM golang:1.26.10@sha256:24a707af49702fa44f02785475d02fb752f6982d3e9c0afb7696e1f0204e7ce9 AS cosign
RUN CGO_ENABLED=0 GOTOOLCHAIN=local GOBIN=/out go install -trimpath \
    -ldflags "-s -w -X sigs.k8s.io/release-utils/version.gitVersion=v2.6.5" \
    github.com/sigstore/cosign/v2/cmd/cosign@v2.6.5

FROM docker:29.9.2-dind
RUN apk add --no-cache 'ca-certificates>=20261020-r0'

ENV DOCKER_HOST=unix:///var/run/docker.sock

# Install cosign for container image signing
COPY --from=cosign /out/cosign /usr/local/bin/cosign

ADD release/linux/amd64/drone-docker /bin/
ENTRYPOINT ["/usr/local/bin/dockerd-entrypoint.sh", "/bin/drone-docker"]
